# GEMINI_API_KEY: Required for Gemini AI API calls (injected by AI Studio).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Security Secrets
SECRET_KEY="change_this_secret_in_production"
JWT_SECRET_KEY="change_this_jwt_secret_in_production"

# SQLite Database
DATABASE_URL="sqlite:///fashion_store.db"

# Hugging Face Virtual Try-On Configuration
# Supports Gradio Space IDs (e.g. yisol/IDM-VTON, zhengchong/CatVTON) or custom HTTP endpoints
HF_API_TOKEN=""
HF_MODEL_ID="yisol/IDM-VTON"
HF_API_URL=""

# Storage Directories (relative to backend/)
UPLOAD_FOLDER="uploads"
GENERATED_FOLDER="generated"
